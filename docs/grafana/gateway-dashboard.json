{
  "uid": "banking-gateway",
  "title": "Banking API Gateway",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (routeId) (rate(spring_cloud_gateway_requests_seconds_count[5m]))",
          "legendFormat": "{{routeId}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p99 latency by route",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, routeId) (rate(spring_cloud_gateway_requests_seconds_bucket[5m])))",
          "legendFormat": "{{routeId}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx error rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(spring_cloud_gateway_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(spring_cloud_gateway_requests_seconds_count[5m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Circuit breaker state",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state",
          "legendFormat": "{{name}} {{state}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Rate-limit decisions",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (policy, decision) (rate(gateway_rate_limit_total[5m]))",
          "legendFormat": "{{policy}} {{decision}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Auth and policy rejections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (code) (rate(gateway_auth_failures_total[5m]))",
          "legendFormat": "auth {{code}}"
        },
        {
          "expr": "sum by (code) (rate(gateway_policy_rejections_total[5m]))",
          "legendFormat": "policy {{code}}"
        },
        {
          "expr": "sum by (code) (rate(gateway_upstream_failures_total[5m]))",
          "legendFormat": "upstream {{code}}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  }
}
