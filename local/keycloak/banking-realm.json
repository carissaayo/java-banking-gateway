{
  "id": "banking",
  "realm": "banking",
  "displayName": "Banking local demo",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "customer-app",
      "name": "Customer app (local demo)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-demo-customer-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["gateway-audience"],
      "optionalClientScopes": [
        "ledger.accounts.read",
        "ledger.transfers.read",
        "ledger.transfers.write",
        "transactions.read",
        "customers.read",
        "customers.write"
      ]
    },
    {
      "clientId": "operations-app",
      "name": "Operations app (local demo)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-demo-operations-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["gateway-audience"],
      "optionalClientScopes": [
        "operations.read",
        "operations.admin",
        "ledger.accounts.read",
        "transactions.read"
      ]
    },
    {
      "clientId": "service-app",
      "name": "Internal service (local demo)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-demo-service-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": ["gateway-audience", "ledger.accounts.read", "transactions.read"],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    {
      "name": "gateway-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-banking-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "banking-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "ledger.accounts.read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "ledger.accounts.write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "ledger.transfers.read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "ledger.transfers.write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "transactions.read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "customers.read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "customers.write",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "operations.read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    },
    {
      "name": "operations.admin",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" }
    }
  ]
}
